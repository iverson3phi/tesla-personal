# 템플릿 — scripts/install.sh 가 @USER@ @HOME@ @ROOT@ 를 치환해 /etc/systemd/system 에 설치한다.
# 직접 복사하지 말 것(자리표시자가 그대로 남는다).
[Unit]
Description=Tesla after-blow ntfy listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
# tesla-sentry는 설정을 ~/.config/tesla-sentry 에서 찾으므로 HOME이 필요하다.
Environment=HOME=@HOME@
ExecStart=@ROOT@/scripts/afterblow-listener.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
